# Copy this file to .env.local and fill in real values. Never commit .env.local.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# docs/FORMS_SETUP.md explains where each value comes from.

# The public address of the site, with no trailing slash.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Forms: email through Resend (https://resend.com)
# Without RESEND_API_KEY and FORMS_FROM, forms on your own machine print each
# message in the terminal instead of sending it. On Vercel they show a polite
# "could not send" message instead.
# ---------------------------------------------------------------------------

# Secret API key from Resend → API Keys. Starts with "re_". Keep it secret.
RESEND_API_KEY=

# The sender shown on every email. Must use a domain verified in Resend.
# Example: ASSOCADS <forms@example.org>
FORMS_FROM=

# The secretariat address that receives every form, unless a more specific
# address is set below.
FORMS_TO=

# Optional: a different secretariat address for each kind of message.
# Leave any of these blank to use FORMS_TO.
FORMS_TO_MEMBERSHIP=
FORMS_TO_COMMUNITIES=
FORMS_TO_PARTNERSHIPS=
FORMS_TO_SUPPORT=
# Idea and innovation submissions (/innovation). Blank means FORMS_TO.
FORMS_TO_INNOVATION=
# Mentorship and career sign-ups (/mentorship). Blank means FORMS_TO.
FORMS_TO_MENTORSHIP=
# Industry and academic collaboration proposals (/collaborate). Blank means FORMS_TO.
FORMS_TO_COLLABORATION=
# AI Digest subscriptions (/digest). Blank means FORMS_TO.
FORMS_TO_NEWSLETTER=
# Contact form, by the topic the visitor chooses (membership and partnership
# topics use the two addresses above):
FORMS_TO_EVENTS=
FORMS_TO_MEDIA=
# Concerns about conduct (contact form). Use a small, trusted inbox.
FORMS_TO_CONDUCT=
FORMS_TO_CONTACT=

# ---------------------------------------------------------------------------
# Forms: spam protection with Cloudflare Turnstile
# (https://dash.cloudflare.com → Turnstile)
# Without these, forms work on your own machine with no security check.
# On Vercel the secret key is required, or forms will not send.
# ---------------------------------------------------------------------------

# Public site key. Safe to show in the page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key, checked on the server. Keep it secret.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Search engine ownership (docs/LAUNCH_DAY_SEARCH_SETUP.md)
# Paste only the content value from the meta tag each service gives you.
# Each tag appears on the site only when its value is set. Redeploy after
# setting or changing them, because pages are built ahead of time.
# ---------------------------------------------------------------------------

# Google Search Console → Add property → URL prefix → HTML tag.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → Add a site → HTML Meta Tag (the msvalidate.01 value).
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Admin editor at /admin: the GitHub OAuth App that signs admins in.
# Production only. How to create it: docs/ADMIN_GUIDE.md, section 2.
# ---------------------------------------------------------------------------
DECAP_GITHUB_CLIENT_ID=
DECAP_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Automated tests only. Never set this on Vercel (it is ignored there).
# The Playwright tests set it themselves; you do not need it in .env.local.
# ---------------------------------------------------------------------------
# FORMS_TEST_OUTBOX=
